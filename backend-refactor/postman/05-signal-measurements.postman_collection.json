          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has objects format fields', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('measurements').that.is.an('array');",
              "  pm.expect(json).to.not.have.property('timestamps');",
              "  pm.expect(json).to.not.have.property('signal_ids');",
              "  pm.expect(json).to.not.have.property('values');",
              "});"
            ]
          }
        }
      ]
