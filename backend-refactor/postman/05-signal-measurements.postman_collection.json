{
  "info": {
    "name": "AssetAPI - Signal Measurements",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Single-signal measurement endpoint integration tests."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "GET /signals/427038/measurements returns measurements",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/signals/427038/measurements?from=2021-11-07T00:00:00&to=2022-02-08T00:00:00",
          "host": ["{{baseUrl}}"],
          "path": ["signals", "427038", "measurements"],
          "query": [
            { "key": "from", "value": "2021-11-07T00:00:00" },
            { "key": "to", "value": "2022-02-08T00:00:00" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has pagination and measurements', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.total).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.count).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.limit).to.eql(1000);",
              "  pm.expect(json.offset).to.eql(0);",
              "  pm.expect(json.count).to.be.at.most(json.limit);",
              "  pm.expect(json.measurements).to.be.an('array').with.lengthOf(json.count);",
              "});",
              "pm.test('measurement has expected fields', () => {",
              "  const m = pm.response.json().measurements[0];",
              "  pm.expect(m).to.have.all.keys('timestamp', 'signal_id', 'value');",
              "  pm.expect(m.signal_id).to.eql(427038);",
              "  pm.expect(m.value).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /signals/427038/measurements with pagination",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/signals/427038/measurements?from=2021-11-07T00:00:00&to=2022-02-08T00:00:00&limit=5&offset=10",
          "host": ["{{baseUrl}}"],
          "path": ["signals", "427038", "measurements"],
          "query": [
            { "key": "from", "value": "2021-11-07T00:00:00" },
            { "key": "to", "value": "2022-02-08T00:00:00" },
            { "key": "limit", "value": "5" },
            { "key": "offset", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('respects limit and offset', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.limit).to.eql(5);",
              "  pm.expect(json.offset).to.eql(10);",
              "  pm.expect(json.count).to.eql(5);",
              "  pm.expect(json.total).to.be.greaterThan(15);",
              "  pm.expect(json.measurements).to.have.lengthOf(5);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /signals/427038/measurements with date filter",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/signals/427038/measurements?from=2021-11-07T00:00:00&to=2021-11-08T00:00:00",
          "host": ["{{baseUrl}}"],
          "path": ["signals", "427038", "measurements"],
          "query": [
            { "key": "from", "value": "2021-11-07T00:00:00" },
            { "key": "to", "value": "2021-11-08T00:00:00" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('returns filtered measurements', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.total).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.count).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.measurements).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
