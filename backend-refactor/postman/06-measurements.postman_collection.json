    {
      "name": "GET /measurements?format=flat returns flat format",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/measurements?signal_ids=427038,427659&from=2021-11-07T00:00:00&to=2022-02-08T00:00:00&format=flat",
          "host": ["{{baseUrl}}"],
          "path": ["measurements"],
          "query": [
            { "key": "signal_ids", "value": "427038,427659" },
            { "key": "from", "value": "2021-11-07T00:00:00" },
            { "key": "to", "value": "2022-02-08T00:00:00" },
            { "key": "format", "value": "flat" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has flat format fields', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.all.keys('total', 'count', 'limit', 'offset', 'timestamps', 'signal_ids', 'values');",
              "  pm.expect(json).to.not.have.property('measurements');",
              "  pm.expect(json.timestamps).to.be.an('array');",
              "  pm.expect(json.signal_ids).to.be.an('array');",
              "  pm.expect(json.values).to.be.an('array');",
              "});",
              "pm.test('parallel arrays have same length as count', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.timestamps).to.have.lengthOf(json.count);",
              "  pm.expect(json.signal_ids).to.have.lengthOf(json.count);",
              "  pm.expect(json.values).to.have.lengthOf(json.count);",
              "});",
              "pm.test('signal_ids belong to requested signals', () => {",
              "  const allowed = [427038, 427659];",
              "  pm.response.json().signal_ids.forEach(id => {",
              "    pm.expect(allowed).to.include(id);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
