{
  "info": {
    "name": "AssetAPI - Measurements (multi-signal)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Multi-signal measurement endpoint integration tests."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "GET /measurements with valid signal_ids",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/measurements?signal_ids=427038,427659&from=2021-11-07T00:00:00&to=2022-02-08T00:00:00",
          "host": ["{{baseUrl}}"],
          "path": ["measurements"],
          "query": [
            { "key": "signal_ids", "value": "427038,427659" },
            { "key": "from", "value": "2021-11-07T00:00:00" },
            { "key": "to", "value": "2022-02-08T00:00:00" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('has pagination and measurements', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.total).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.count).to.be.a('number').and.to.be.greaterThan(0);",
              "  pm.expect(json.limit).to.eql(1000);",
              "  pm.expect(json.offset).to.eql(0);",
              "  pm.expect(json.measurements).to.be.an('array').with.lengthOf(json.count);",
              "});",
              "pm.test('measurements belong to requested signals', () => {",
              "  const allowed = [427038, 427659];",
              "  pm.response.json().measurements.forEach(m => {",
              "    pm.expect(allowed).to.include(m.signal_id);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
