              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has flat format fields', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.all.keys('total', 'count', 'limit', 'offset', 'timestamps', 'signal_ids', 'values');",
                  "  pm.expect(json).to.not.have.property('measurements');",
                  "  pm.expect(json.timestamps).to.be.an('array');",
                  "  pm.expect(json.signal_ids).to.be.an('array');",
                  "  pm.expect(json.values).to.be.an('array');",
                  "});",
                  "pm.test('parallel arrays have same length as count', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.timestamps).to.have.lengthOf(json.count);",
                  "  pm.expect(json.signal_ids).to.have.lengthOf(json.count);",
                  "  pm.expect(json.values).to.have.lengthOf(json.count);",
                  "});",
                  "pm.test('all signal_ids are 427038', () => {",
                  "  pm.response.json().signal_ids.forEach(id => {",
                  "    pm.expect(id).to.eql(427038);",
                  "  });",
                  "});"
                ]
