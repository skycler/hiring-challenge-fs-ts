{
  "info": {
    "name": "AssetAPI Integration Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "End-to-end integration tests for the AssetAPI. Run with Newman against a live instance."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health returns 200 with status ok",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has status ok', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "GET /assets returns all assets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/assets",
              "host": ["{{baseUrl}}"],
              "path": ["assets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns 3 assets', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array').with.lengthOf(3);",
                  "});",
                  "pm.test('asset has expected fields', () => {",
                  "  const a = pm.response.json()[0];",
                  "  pm.expect(a).to.have.all.keys('asset_id', 'latitude', 'longitude', 'description');",
                  "  pm.expect(a.asset_id).to.be.a('number');",
                  "  pm.expect(a.latitude).to.be.a('number');",
                  "  pm.expect(a.longitude).to.be.a('number');",
                  "  pm.expect(a.description).to.be.a('string');",
                  "});"
