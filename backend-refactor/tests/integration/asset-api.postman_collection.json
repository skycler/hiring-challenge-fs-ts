                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has pagination and measurements', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.total).to.be.a('number').and.to.be.greaterThan(0);",
                  "  pm.expect(json.count).to.be.a('number').and.to.be.greaterThan(0);",
